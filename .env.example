AGENT_API_KEY=your-key-here
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=your-model-name

# Optional runtime limits
# AGENT_WORKSPACE=/path/to/project
# AGENT_MAX_STEPS=30
# AGENT_MAX_TIME=600
# AGENT_MAX_TOOL_CHARS=12000
# AGENT_MAX_GROUPS=8
# AGENT_MAX_CONTEXT_CHARS=60000
# AGENT_MAX_CONTEXT_TOKENS=32000
# AGENT_MAX_TASK_TOKENS=0  # 0 disables the per-task total-token limit
# AGENT_CONTEXT_KEEP_FULL_GROUPS=1
# AGENT_MAX_PROJECT_CONTEXT_CHARS=12000
# AGENT_MAX_FILE_REFERENCE_CHARS=12000
# AGENT_MAX_FILE_REFERENCE_TOTAL_CHARS=20000
# AGENT_CMD_TIMEOUT=60
# AGENT_MAX_ERRORS=4
# AGENT_MAX_IDENTICAL_CALLS=3
# AGENT_CONFIRM=true
# AGENT_PERMISSION_MODE=balanced
# AGENT_FINAL_VERIFIER=python -m unittest discover -s tests -v
